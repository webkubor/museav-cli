# 本地开发（mode=development，`pnpm dev` 默认走这份）
#
# 与 .env.test 的关键区别：三个 API 地址变量**必须留空**。
# request.ts 的 apiBaseUrl() 取值顺序是
#   VITE_DOMESTIC/GLOBAL_API_DOMAIN → VITE_API_URL → ''
# 三者都空才会返回 ''，请求打到相对路径 /api/v1/...，命中 vite.config.ts 里的 '/api/' proxy——
# 那个 proxy 会把 Origin 改写成 https://console.test.modelgo.com（后端 CORS 白名单里的值），
# 并修本地 cookie（去 Domain / 剥 Secure / SameSite=None→Lax）。
#
# 一旦这里填了绝对地址（像 .env.test 那样），浏览器就直连 test 网关、proxy 形同虚设，
# 后端 CORS 白名单不含 localhost:<任意端口>，POST /auth/login 一律 403，
# 页面顶部报「请求失败，请稍后重试」，登录都进不去。2026-08-17 踩过：当时把 `pnpm dev`
# 改成 `--mode test` 来绕开本文件缺失的报错，结果就是丢了 proxy。
VITE_API_URL=
VITE_DOMESTIC_API_DOMAIN=
VITE_GLOBAL_API_DOMAIN=

VITE_MOCK=false
VITE_SHOW_DEV_TOOLS=true

# ── 跳转地址（官网/控制台/文档）──────────────────────────
# vite.config.ts 对这 6 个做硬校验，缺一个就中断启动（禁止留空或硬编码兜底）。
# 本地开发指向 test 站，与 .env.test 同值。
VITE_DOMESTIC_SITE=https://web.test.modelgo.com
VITE_DOMESTIC_CONSOLE=https://console.test.modelgo.com
VITE_DOMESTIC_DOCS=https://docs.test.modelgo.com
VITE_GLOBAL_SITE=https://global-web.test.modelgo.com
VITE_GLOBAL_CONSOLE=https://console.test.modelgo.com
VITE_GLOBAL_DOCS=https://docs.test.modelgo.com

# ── 微信小程序 ──────────────────────────────────────────
VITE_WX_MP_APP_ID=wx4369fd0c42ba9646

# 阿里云验证码 2.0：留空 = 前端不弹人机验证（后端二次校验开关在 Nacos，与此分离）。
VITE_ALIYUN_CAPTCHA_SCENE_ID_DOMESTIC=
VITE_ALIYUN_CAPTCHA_PREFIX_DOMESTIC=
VITE_ALIYUN_CAPTCHA_SCENE_ID_GLOBAL=
VITE_ALIYUN_CAPTCHA_PREFIX_GLOBAL=

# 智能客服 mock（VITE_SUPPORT_MOCK）
#
# 客服后端（熊仁杰）开发截止 9/11，服务记录 / 转人工 / 长轮询等端点尚未上线。
# 置 on 时 `components/customer-service/gateway.ts` 走 `mock/` 下的后端替身，
# 九种模式、未读三层、转异步降级都能在浏览器里真跑一遍；置 off（默认）走真接口，
# 未上线就如实报错，不伪造成功。后端上线后删掉这一行与 mock/ 目录。
#   window.__mg_support.forceAsync(true) 切到「无坐席在线 → 转异步」路径
#   window.__mg_support.reset()          重置种子工单
VITE_SUPPORT_MOCK=on

# 模型发现入口：本 feature 分支打开，本地 npm run dev 也能看到入口
VITE_ENABLE_DISCOVERY_ENTRY=on
