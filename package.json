{
  "name": "modelgo-console-web",
  "private": true,
  "version": "1.0.6",
  "type": "module",
  "scripts": {
    "prepare": "sh scripts/install-hooks.sh",
    "dev": "vite --host",
    "build": "tsc -b && vite build && node scripts/generate-legacy-asset-aliases.mjs",
    "build:test": "tsc -b && vite build --mode test && node scripts/generate-legacy-asset-aliases.mjs",
    "build:prod": "tsc -b && vite build --mode production && node scripts/generate-legacy-asset-aliases.mjs",
    "check:api-contract": "node scripts/check-swagger-api.mjs",
    "lint": "eslint .",
    "lint:css": "stylelint \"src/**/*.css\"",
    "lint:css:diff": "node scripts/stylelint-diff.mjs",
    "check:css-tokens:diff": "node scripts/check-css-tokens.mjs",
    "check:css-tokens:full": "node scripts/check-css-tokens.mjs --full",
    "lint:style:diff": "node scripts/eslint-style-diff.mjs",
    "preview": "vite preview",
    "login": "node scripts/login.mjs",
    "test": "vitest run",
    "version:patch": "npm version patch --no-git-tag-version",
    "version:minor": "npm version minor --no-git-tag-version",
    "version:major": "npm version major --no-git-tag-version",
    "sync:api": "bun run scripts/sync-api.ts",
    "sync:permissions:cn": "bun run scripts/sync-permissions.ts --market china",
    "sync:permissions:global": "bun run scripts/sync-permissions.ts --market global",
    "sync:permissions:check": "bun run scripts/sync-permissions.ts --check",
    "check:i18n": "node scripts/check-i18n.mjs",
    "check:orb-theme": "node scripts/check-orb-theme.mjs"
  },
  "dependencies": {
    "@fingerprintjs/fingerprintjs": "^5.2.0",
    "@hookform/resolvers": "^5.4.0",
    "@lobehub/icons": "^5.8.0",
    "@model-go/icons": "3.1.0",
    "@model-go/track": "^0.3.0",
    "@radix-ui/react-avatar": "^1.1.11",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@tanstack/react-query": "^5.100.14",
    "ai-orb": "^0.2.0",
    "ai-sse-kit": "^0.3.0",
    "canvas-confetti": "^1.9.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "copy-to-clipboard": "^4.0.2",
    "crypto-js": "^4.2.0",
    "dayjs": "^1.11.21",
    "i18next": "^26.2.0",
    "jsencrypt": "^3.5.4",
    "ky": "^2.0.2",
    "modelgo-design-tokens": "^0.14.0",
    "qrcode.react": "^4.2.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-hook-form": "^7.76.1",
    "react-i18next": "^17.0.8",
    "react-icons": "^5.6.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.15.1",
    "recharts": "^3.8.1",
    "remark-gfm": "^4.0.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^4.4.3",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/canvas-confetti": "^1.9.0",
    "@types/crypto-js": "^4.2.2",
    "@types/node": "^24.12.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "jsdom": "^29.1.1",
    "stylelint": "^17.13.0",
    "stylelint-declaration-strict-value": "^1.11.1",
    "tailwindcss": "^4.3.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.59.2",
    "vite": "^8.0.12",
    "vite-plugin-agent-eyes": "^0.13.2",
    "vitest": "^4.1.8"
  }
}
