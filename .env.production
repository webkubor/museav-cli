# 生产环境（市场由域名运行时检测，不在此硬编码 VITE_MARKET）

# ── 国内市场 ──────────────────────────────────────────────
VITE_DOMESTIC_API_DOMAIN=modelgo-web-api.modelgo.com
VITE_DOMESTIC_SITE=https://modelgo.com
VITE_DOMESTIC_CONSOLE=https://console.modelgo.com
VITE_DOMESTIC_DOCS=https://docs.modelgo.com
VITE_ICP=浙ICP备2026032844号-1

# ── 海外市场 ──────────────────────────────────────────────
VITE_GLOBAL_API_DOMAIN=modelgo-web-api.modelgo.ai
VITE_GLOBAL_SITE=https://modelgo.ai
VITE_GLOBAL_CONSOLE=https://console.modelgo.ai
VITE_GLOBAL_DOCS=https://docs.modelgo.ai

# ── LLM 网关域名（API Keys 快速接入示例用） ──────────────
VITE_API_GATEWAY_DOMAIN=api.modelgo.com

# 阿里云验证码 2.0（qa#299）：留空 = 禁用（登录/注册/发码不弹人机验证，端到端降级）。
# 由运维在阿里云验证码 2.0 控制台按国内/海外分别建场景后填入 SceneId + prefix。
# 后端二次校验开关与 AK/SK 走 Nacos（modelgo-permissions captcha.*），与此分离。
VITE_ALIYUN_CAPTCHA_SCENE_ID_DOMESTIC=
VITE_ALIYUN_CAPTCHA_PREFIX_DOMESTIC=
VITE_ALIYUN_CAPTCHA_SCENE_ID_GLOBAL=
VITE_ALIYUN_CAPTCHA_PREFIX_GLOBAL=
