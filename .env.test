# 测试环境（市场由域名判定：console.test.modelgo.com → 国内；dev 工具条可运行时切换预览海外）
VITE_MOCK=false
VITE_SHOW_DEV_TOOLS=true
VITE_API_URL=https://modelgo-web-api.test.modelgo.com

# ── 国内市场 ──────────────────────────────────────────────
VITE_DOMESTIC_API_DOMAIN=modelgo-web-api.test.modelgo.com
VITE_DOMESTIC_SITE=https://web.test.modelgo.com
VITE_DOMESTIC_CONSOLE=https://console.test.modelgo.com
VITE_DOMESTIC_DOCS=https://docs.test.modelgo.com

# ── 海外市场 ──────────────────────────────────────────────
VITE_GLOBAL_API_DOMAIN=modelgo-web-api.test.modelgo.com
VITE_GLOBAL_SITE=https://global-web.test.modelgo.com
VITE_GLOBAL_CONSOLE=https://console.test.modelgo.com
VITE_GLOBAL_DOCS=https://docs.test.modelgo.com


# ── LLM 网关域名（仅 API Keys / API 调试台示例展示用） ───

# ── 微信小程序 ──────────────────────────────────────────
VITE_WX_MP_APP_ID=wx4369fd0c42ba9646

# 阿里云验证码 2.0（qa#299）：留空 = 禁用（登录/注册/发码不弹人机验证，端到端降级）。
# 由运维在阿里云验证码 2.0 控制台按国内/海外分别建场景后填入 SceneId + prefix。
# 后端二次校验开关与 AK/SK 走 Nacos（modelgo-permissions captcha.*），与此分离。
VITE_ALIYUN_CAPTCHA_SCENE_ID_DOMESTIC=
VITE_ALIYUN_CAPTCHA_PREFIX_DOMESTIC=
VITE_ALIYUN_CAPTCHA_SCENE_ID_GLOBAL=
VITE_ALIYUN_CAPTCHA_PREFIX_GLOBAL=
